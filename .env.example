# Optional: first-boot password, only read when database contains no users.
# Prefer the automatically generated password printed on first startup.
# QIANG_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
QIANG_HOST=127.0.0.1
QIANG_PORT=8000
QIANG_DATA_DIR=data
# Set to 1 behind HTTPS. Do not set on plain HTTP localhost.
QIANG_SECURE_COOKIE=0
# QIANG_PDF_FONT=/path/to/licensed/chinese-font.ttf

# Optional model path: gateway or openai_responses. Not enabled without URL/model.
QIANG_AI_PROTOCOL=gateway
# QIANG_AI_GATEWAY_URL=https://your-enterprise-gateway.example/extract
# QIANG_AI_MODEL=your-enabled-model-version
# QIANG_AI_GATEWAY_TOKEN=configure-in-server-environment-only
# Preferred: retrieve model key from an authenticated internal service.
# QIANG_SECRET_ENDPOINT=http://127.0.0.1:8101/v1/secrets/ai-gateway
# QIANG_SECRET_SERVICE_TOKEN_FILE=/run/secrets/qiang-service-token
# Key service only (not needed by workbench when endpoint is configured):
# QIANG_AI_GATEWAY_TOKEN_FILE=/run/secrets/qiang-model-key
